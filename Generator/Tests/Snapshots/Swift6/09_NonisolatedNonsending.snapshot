import Cuckoo
import Foundation

class MockLoader: Loader, Cuckoo.ProtocolMock, @unchecked Sendable {
    typealias MocksType = any Loader
    typealias Stubbing = __StubbingProxy_Loader
    typealias Verification = __VerificationProxy_Loader

    // Original typealiases

    let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    private let __defaultImplStub = Cuckoo.DefaultImplementation<any Loader>()

    nonisolated func enableDefaultImplementation(_ stub: any Loader) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    func load() async -> Int {
        return await cuckoo_manager.call(
            "load() async -> Int",
            parameters: (),
            escapingParameters: (),
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.load()
        )
    }

    func compute() async -> Int {
        return await cuckoo_manager.call(
            "compute() async -> Int",
            parameters: (),
            escapingParameters: (),
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.compute()
        )
    }

    struct __StubbingProxy_Loader: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func load() -> Cuckoo.ProtocolStubFunction<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockLoader.self,
                method: "load() async -> Int",
                parameterMatchers: matchers
            ))
        }
        
        func compute() -> Cuckoo.ProtocolStubFunction<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockLoader.self,
                method: "compute() async -> Int",
                parameterMatchers: matchers
            ))
        }
    }

    struct __VerificationProxy_Loader: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func load() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "load() async -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func compute() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "compute() async -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

class LoaderStub:Loader, @unchecked Sendable {


    
    func load() async -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
    
    func compute() async -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
}



