import Cuckoo
import Foundation

nonisolated final class MockLoader: Loader, nonisolated Cuckoo.ProtocolMock {
    typealias CuckooMocksType = any Loader
    typealias CuckooStubbing = __StubbingProxy_Loader
    typealias CuckooVerification = __VerificationProxy_Loader

    // Original typealiases

    nonisolated let cuckooManager = Cuckoo.MockManager.preconfiguredManager(for: MockLoader.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let cuckooDefaultImplementation = Cuckoo.DefaultImplementation<any Loader>()

    nonisolated func enableDefaultImplementation(_ stub: any Loader) {
        cuckooDefaultImplementation.value = stub
        cuckooManager.enableDefaultStubImplementation()
    }

    nonisolated(nonsending)
    func load() async -> Int {
        return await cuckooManager.call(
            "load() async -> Int",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: nonisolated(nonsending) (()) async -> Int, arguments) in
                await implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await cuckooDefaultImplementation.value.load()
        )
    }

    @concurrent
    func compute() async -> Int {
        return await cuckooManager.call(
            "compute() async -> Int",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: nonisolated(nonsending) (()) async -> Int, arguments) in
                await implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await cuckooDefaultImplementation.value.compute()
        )
    }

    nonisolated struct __StubbingProxy_Loader: Cuckoo.StubbingProxy {
        private let cuckooManager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckooManager = manager
        }

        func load() -> Cuckoo.ProtocolStubFunction<(), Int, nonisolated(nonsending) (()) async -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckooManager.createStub(for: MockLoader.self,
                method: "load() async -> Int",
                parameterMatchers: matchers
            ))
        }

        func compute() -> Cuckoo.ProtocolStubFunction<(), Int, nonisolated(nonsending) (()) async -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckooManager.createStub(for: MockLoader.self,
                method: "compute() async -> Int",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_Loader: Cuckoo.VerificationProxy {
        private let cuckooManager: Cuckoo.MockManager
        private let cuckooCallMatcher: Cuckoo.CallMatcher
        private let cuckooSourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckooManager = manager
            self.cuckooCallMatcher = callMatcher
            self.cuckooSourceLocation = sourceLocation
        }

        @discardableResult
        func load() -> Cuckoo.VerifiedCall<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckooManager.verify(
                "load() async -> Int",
                callMatcher: cuckooCallMatcher,
                parameterMatchers: matchers,
                sourceLocation: cuckooSourceLocation
            )
        }

        @discardableResult
        func compute() -> Cuckoo.VerifiedCall<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckooManager.verify(
                "compute() async -> Int",
                callMatcher: cuckooCallMatcher,
                parameterMatchers: matchers,
                sourceLocation: cuckooSourceLocation
            )
        }
    }
}

nonisolated final class LoaderStub: Loader {
    nonisolated(nonsending)
    func load() async -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }

    @concurrent
    func compute() async -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
}
