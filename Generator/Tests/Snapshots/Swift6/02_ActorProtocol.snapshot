import Cuckoo
import Foundation

actor MockStore: Store, Cuckoo.ProtocolMock {
    typealias MocksType = any Store
    typealias Stubbing = __StubbingProxy_Store
    typealias Verification = __VerificationProxy_Store

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any Store>()

    nonisolated func enableDefaultImplementation(_ stub: any Store) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    var count: Int {
        get {
            return cuckoo_manager.getter(
                "count",
                invoke: { (implementation: @Sendable (isolated MockStore) -> Int) in implementation(self) },
                superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
                defaultCall: Cuckoo.MockManager.crashOnActorDefaultImplementationCall("count")
            )
        }
    }


    func increment() -> Int {
        return cuckoo_manager.call(
            "increment() -> Int",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: @Sendable (isolated MockStore) -> Int) in implementation(self) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: Cuckoo.MockManager.crashOnActorDefaultImplementationCall("increment() -> Int")
        )
    }

    func fetch() async -> [String] {
        return await cuckoo_manager.call(
            "fetch() async -> [String]",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: @Sendable (isolated MockStore) async -> [String]) in await implementation(self) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.fetch()
        )
    }

    nonisolated struct __StubbingProxy_Store: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        var count: Cuckoo.ProtocolToBeStubbedReadOnlyProperty<MockStore, Int, @Sendable (isolated MockStore) -> Int, Cuckoo.StubSharing.Shared> {
            return .init(manager: cuckoo_manager, name: "count")
        }
        
        func increment() -> Cuckoo.ProtocolStubFunction<(), Int, @Sendable (isolated MockStore) -> Int, Cuckoo.StubSharing.Shared> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockStore.self,
                method: "increment() -> Int",
                parameterMatchers: matchers
            ))
        }
        
        func fetch() -> Cuckoo.ProtocolStubFunction<(), [String], @Sendable (isolated MockStore) async -> [String], Cuckoo.StubSharing.Shared> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockStore.self,
                method: "fetch() async -> [String]",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_Store: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        var count: Cuckoo.VerifyReadOnlyProperty<Int> {
            return .init(manager: cuckoo_manager, name: "count", callMatcher: callMatcher, sourceLocation: sourceLocation)
        }
        
        
        @discardableResult
        func increment() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "increment() -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func fetch() -> Cuckoo.__DoNotUse<(), [String]> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "fetch() async -> [String]",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

actor StoreStub:Store {
    
    var count: Int {
        get {
            return DefaultValueRegistry.defaultValue(for: (Int).self)
        }
    }


    
    func increment() -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
    
    func fetch() async -> [String] {
        return DefaultValueRegistry.defaultValue(for: ([String]).self)
    }
}



