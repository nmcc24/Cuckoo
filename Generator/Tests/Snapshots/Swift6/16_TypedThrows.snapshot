import Cuckoo
import Foundation

nonisolated final class MockTypedAPI: TypedAPI, nonisolated Cuckoo.ProtocolMock {
    typealias MocksType = any TypedAPI
    typealias Stubbing = __StubbingProxy_TypedAPI
    typealias Verification = __VerificationProxy_TypedAPI

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any TypedAPI>()

    nonisolated func enableDefaultImplementation(_ stub: any TypedAPI) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    func call() throws(NetErr) -> Int {
        return try cuckoo_manager.callThrows(
            "call() throws(NetErr) -> Int",
            parameters: (),
            escapingParameters: (),
            errorType: (NetErr).self,
            invoke: { (implementation: (()) throws -> Int) throws(NetErr) in do { return try implementation(()) } catch { throw Cuckoo.MockManager.typedError(error, as: (NetErr).self, member: "call() throws(NetErr) -> Int") } },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.call()
        )
    }

    func callAsync() async throws(NetErr) -> Int {
        return try await cuckoo_manager.callThrows(
            "callAsync() async throws(NetErr) -> Int",
            parameters: (),
            escapingParameters: (),
            errorType: (NetErr).self,
            invoke: { (implementation: nonisolated(nonsending) (()) async throws -> Int) async throws(NetErr) in do { return try await implementation(()) } catch { throw Cuckoo.MockManager.typedError(error, as: (NetErr).self, member: "callAsync() async throws(NetErr) -> Int") } },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.callAsync()
        )
    }

    nonisolated struct __StubbingProxy_TypedAPI: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func call() -> Cuckoo.ProtocolStubThrowingFunction<(), Int,NetErr, (()) throws -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "call() throws(NetErr) -> Int",
                parameterMatchers: matchers
            ))
        }
        
        func callAsync() -> Cuckoo.ProtocolStubThrowingFunction<(), Int,NetErr, nonisolated(nonsending) (()) async throws -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "callAsync() async throws(NetErr) -> Int",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_TypedAPI: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func call() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "call() throws(NetErr) -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func callAsync() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "callAsync() async throws(NetErr) -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

nonisolated final class TypedAPIStub:TypedAPI {


    
    func call() throws(NetErr) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
    
    func callAsync() async throws(NetErr) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
}



