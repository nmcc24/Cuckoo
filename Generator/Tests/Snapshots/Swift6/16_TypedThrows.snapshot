import Cuckoo
import Foundation

nonisolated final class MockTypedAPI: TypedAPI, nonisolated Cuckoo.ProtocolMock {
    typealias MocksType = any TypedAPI
    typealias Stubbing = __StubbingProxy_TypedAPI
    typealias Verification = __VerificationProxy_TypedAPI

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any TypedAPI>()

    nonisolated func enableDefaultImplementation(_ stub: any TypedAPI) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    func call() throws(NetErr) -> Int {
        return try cuckoo_manager.callThrows(
            "call() throws(NetErr) -> Int",
            parameters: (),
            escapingParameters: (),
            errorType: (NetErr).self,
            invoke: { (implementation: (()) throws -> Int, arguments) throws(NetErr) in
                do {
                    return try implementation(arguments)
                } catch {
                    throw Cuckoo.MockManager.typedError(error, as: (NetErr).self, member: "call() throws(NetErr) -> Int")
                }
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.call()
        )
    }

    func callAsync() async throws(NetErr) -> Int {
        return try await cuckoo_manager.callThrows(
            "callAsync() async throws(NetErr) -> Int",
            parameters: (),
            escapingParameters: (),
            errorType: (NetErr).self,
            invoke: { (implementation: nonisolated(nonsending) (()) async throws -> Int, arguments) async throws(NetErr) in
                do {
                    return try await implementation(arguments)
                } catch {
                    throw Cuckoo.MockManager.typedError(error, as: (NetErr).self, member: "callAsync() async throws(NetErr) -> Int")
                }
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.callAsync()
        )
    }

    func fetch() throws(Network.Failure) -> String {
        return try cuckoo_manager.callThrows(
            "fetch() throws(Network.Failure) -> String",
            parameters: (),
            escapingParameters: (),
            errorType: (Network.Failure).self,
            invoke: { (implementation: (()) throws -> String, arguments) throws(Network.Failure) in
                do {
                    return try implementation(arguments)
                } catch {
                    throw Cuckoo.MockManager.typedError(error, as: (Network.Failure).self, member: "fetch() throws(Network.Failure) -> String")
                }
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.fetch()
        )
    }

    func decode() throws(Wrapped<Int>) {
        return try cuckoo_manager.callThrows(
            "decode() throws(Wrapped<Int>)",
            parameters: (),
            escapingParameters: (),
            errorType: (Wrapped<Int>).self,
            invoke: { (implementation: (()) throws -> Void, arguments) throws(Wrapped<Int>) in
                do {
                    return try implementation(arguments)
                } catch {
                    throw Cuckoo.MockManager.typedError(error, as: (Wrapped<Int>).self, member: "decode() throws(Wrapped<Int>)")
                }
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.decode()
        )
    }

    func retry(_ p0: @escaping () throws(NetErr) -> Int) -> Int {
        return cuckoo_manager.call(
            "retry(_ p0: @escaping () throws(NetErr) -> Int) -> Int",
            parameters: (p0),
            escapingParameters: (p0),
            invoke: { (implementation: ((@escaping () throws(NetErr) -> Int)) -> Int, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.retry(p0)
        )
    }

    func log(_ p0: (String...) -> Void) {
        return withoutActuallyEscaping(p0, do: { (p0: @escaping (String...) -> Void) in
            return cuckoo_manager.call(
                "log(_ p0: (String...) -> Void)",
                parameters: (p0),
                escapingParameters: (({ _ in
                                        fatalError("This is a stub! It's not supposed to be called!")
                                    } as (String...) -> Void)),
                invoke: { (implementation: ((@escaping (String...) -> Void)) -> Void, arguments) in
                                implementation(arguments)
                            },
                superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
                defaultCall: __defaultImplStub.value.log(p0)
            )
        })
    }

    nonisolated struct __StubbingProxy_TypedAPI: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }

        func call() -> Cuckoo.ProtocolStubThrowingFunction<(), Int, NetErr, (()) throws -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "call() throws(NetErr) -> Int",
                parameterMatchers: matchers
            ))
        }

        func callAsync() -> Cuckoo.ProtocolStubThrowingFunction<(), Int, NetErr, nonisolated(nonsending) (()) async throws -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "callAsync() async throws(NetErr) -> Int",
                parameterMatchers: matchers
            ))
        }

        func fetch() -> Cuckoo.ProtocolStubThrowingFunction<(), String, Network.Failure, (()) throws -> String, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "fetch() throws(Network.Failure) -> String",
                parameterMatchers: matchers
            ))
        }

        func decode() -> Cuckoo.ProtocolStubNoReturnThrowingFunction<(), Wrapped<Int>, (()) throws -> Void, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "decode() throws(Wrapped<Int>)",
                parameterMatchers: matchers
            ))
        }

        func retry<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubFunction<(() throws(NetErr) -> Int), Int, ((@escaping () throws(NetErr) -> Int)) -> Int, Cuckoo.StubSharing.Confined> where M1.MatchedType == () throws(NetErr) -> Int {
            let matchers: [Cuckoo.ParameterMatcher<(() throws(NetErr) -> Int)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "retry(_ p0: @escaping () throws(NetErr) -> Int) -> Int",
                parameterMatchers: matchers
            ))
        }

        func log<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubNoReturnFunction<((String...) -> Void), ((@escaping (String...) -> Void)) -> Void, Cuckoo.StubSharing.Confined> where M1.MatchedType == (String...) -> Void {
            let matchers: [Cuckoo.ParameterMatcher<((String...) -> Void)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockTypedAPI.self,
                method: "log(_ p0: (String...) -> Void)",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_TypedAPI: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }

        @discardableResult
        func call() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "call() throws(NetErr) -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }

        @discardableResult
        func callAsync() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "callAsync() async throws(NetErr) -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }

        @discardableResult
        func fetch() -> Cuckoo.__DoNotUse<(), String> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "fetch() throws(Network.Failure) -> String",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }

        @discardableResult
        func decode() -> Cuckoo.__DoNotUse<(), Void> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "decode() throws(Wrapped<Int>)",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }

        @discardableResult
        func retry<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<(() throws(NetErr) -> Int), Int> where M1.MatchedType == () throws(NetErr) -> Int {
            let matchers: [Cuckoo.ParameterMatcher<(() throws(NetErr) -> Int)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckoo_manager.verify(
                "retry(_ p0: @escaping () throws(NetErr) -> Int) -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }

        @discardableResult
        func log<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<((String...) -> Void), Void> where M1.MatchedType == (String...) -> Void {
            let matchers: [Cuckoo.ParameterMatcher<((String...) -> Void)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckoo_manager.verify(
                "log(_ p0: (String...) -> Void)",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

nonisolated final class TypedAPIStub: TypedAPI {
    func call() throws(NetErr) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }

    func callAsync() async throws(NetErr) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }

    func fetch() throws(Network.Failure) -> String {
        return DefaultValueRegistry.defaultValue(for: (String).self)
    }

    func decode() throws(Wrapped<Int>) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }

    func retry(_ p0: @escaping () throws(NetErr) -> Int) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }

    func log(_ p0: (String...) -> Void) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}
