import Cuckoo
import Foundation

nonisolated final class MockConsumer: Consumer, nonisolated Cuckoo.ProtocolMock {
    typealias CuckooMocksType = any Consumer
    typealias CuckooStubbing = __StubbingProxy_Consumer
    typealias CuckooVerification = __VerificationProxy_Consumer

    // Original typealiases

    nonisolated let cuckooManager = Cuckoo.MockManager.preconfiguredManager(for: MockConsumer.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let cuckooDefaultImplementation = Cuckoo.DefaultImplementation<any Consumer>()

    nonisolated func enableDefaultImplementation(_ stub: any Consumer) {
        cuckooDefaultImplementation.value = stub
        cuckooManager.enableDefaultStubImplementation()
    }

    func consume(_ p0: consuming Token) {
        return cuckooManager.call(
            "consume(_ p0: consuming Token)",
            parameters: (Cuckoo.NoncopyableArgument(type: "Token")),
            escapingParameters: (Cuckoo.NoncopyableArgument(type: "Token")),
            invoke: { (implementation: (borrowing Token) -> Void, arguments) in
                implementation(p0)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: Cuckoo.MockManager.crashOnNoncopyableArgumentForward("consume(_ p0: consuming Token)")
        )
    }

    func inspect(_ p0: borrowing Token) -> Int {
        return cuckooManager.call(
            "inspect(_ p0: borrowing Token) -> Int",
            parameters: (Cuckoo.NoncopyableArgument(type: "Token")),
            escapingParameters: (Cuckoo.NoncopyableArgument(type: "Token")),
            invoke: { (implementation: (borrowing Token) -> Int, arguments) in
                implementation(p0)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: Cuckoo.MockManager.crashOnNoncopyableArgumentForward("inspect(_ p0: borrowing Token) -> Int")
        )
    }

    func redeem(_ p0: consuming Ticket?, seat p1: Int) async throws -> String {
        return try await cuckooManager.callThrows(
            "redeem(_ p0: consuming Ticket?, seat p1: Int) async throws -> String",
            parameters: (Cuckoo.NoncopyableArgument(type: "Ticket?"), p1),
            escapingParameters: (Cuckoo.NoncopyableArgument(type: "Ticket?"), p1),
            errorType: (any Swift.Error).self,
            invoke: { (implementation: nonisolated(nonsending) (borrowing Ticket?, Int) async throws -> String, arguments) async throws(any Swift.Error) in
                try await implementation(p0, arguments.1)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: Cuckoo.MockManager.crashOnNoncopyableArgumentForward("redeem(_ p0: consuming Ticket?, seat p1: Int) async throws -> String")
        )
    }

    func take<T: ~Copyable> (_ p0: consuming T) -> Bool {
        return cuckooManager.call(
            "take<T: ~Copyable> (_ p0: consuming T) -> Bool",
            parameters: (Cuckoo.NoncopyableArgument(type: "T")),
            escapingParameters: (Cuckoo.NoncopyableArgument(type: "T")),
            invoke: { (implementation: ((Cuckoo.NoncopyableArgument)) -> Bool, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: Cuckoo.MockManager.crashOnNoncopyableArgumentForward("take<T: ~Copyable> (_ p0: consuming T) -> Bool")
        )
    }

    func check<T> (_ p0: borrowing T, label p1: String) -> Bool where T: ~Copyable {
        return cuckooManager.call(
            "check<T> (_ p0: borrowing T, label p1: String) -> Bool where T: ~Copyable",
            parameters: (Cuckoo.NoncopyableArgument(type: "T"), p1),
            escapingParameters: (Cuckoo.NoncopyableArgument(type: "T"), p1),
            invoke: { (implementation: ((Cuckoo.NoncopyableArgument, String)) -> Bool, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: Cuckoo.MockManager.crashOnNoncopyableArgumentForward("check<T> (_ p0: borrowing T, label p1: String) -> Bool where T: ~Copyable")
        )
    }

    func visit(_ p0: (borrowing Token) -> Void) {
        return withoutActuallyEscaping(p0, do: { (p0: @escaping (borrowing Token) -> Void) in
            return cuckooManager.call(
                "visit(_ p0: (borrowing Token) -> Void)",
                parameters: (p0),
                escapingParameters: (({ _ in
                                        fatalError("This is a stub! It's not supposed to be called!")
                                    } as (borrowing Token) -> Void)),
                invoke: { (implementation: ((@escaping (borrowing Token) -> Void)) -> Void, arguments) in
                                implementation(arguments)
                            },
                superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
                defaultCall: cuckooDefaultImplementation.value.visit(p0)
            )
        })
    }

