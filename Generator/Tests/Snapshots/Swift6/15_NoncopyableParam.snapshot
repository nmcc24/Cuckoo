            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.NoncopyableArgument, String)>] = [Cuckoo.wrap(matchable: p0) {
                    $0.0
                }, Cuckoo.wrap(matchable: p1) {
                    $0.1
