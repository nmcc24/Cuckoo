import Cuckoo
import Foundation

class MockConsumer: Consumer, Cuckoo.ProtocolMock, @unchecked Sendable {
    typealias MocksType = any Consumer
    typealias Stubbing = __StubbingProxy_Consumer
    typealias Verification = __VerificationProxy_Consumer

    // Original typealiases

    let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    private let __defaultImplStub = Cuckoo.DefaultImplementation<any Consumer>()

    nonisolated func enableDefaultImplementation(_ stub: any Consumer) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    func consume(_ p0: consuming Token) {
        return cuckoo_manager.call(
            "consume(_ p0: consuming Token)",
            parameters: (p0),
            escapingParameters: (p0),
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.consume(p0)
        )
    }

    func inspect(_ p0: borrowing Token) -> Int {
        return cuckoo_manager.call(
            "inspect(_ p0: borrowing Token) -> Int",
            parameters: (p0),
            escapingParameters: (p0),
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.inspect(p0)
        )
    }

    struct __StubbingProxy_Consumer: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func consume<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubNoReturnFunction<( Token)> where M1.MatchedType ==  Token {
            let matchers: [Cuckoo.ParameterMatcher<( Token)>] = [wrap(matchable: p0) { $0 }]
            return .init(stub: cuckoo_manager.createStub(for: MockConsumer.self,
                method: "consume(_ p0: consuming Token)",
                parameterMatchers: matchers
            ))
        }
        
        func inspect<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubFunction<( Token), Int> where M1.MatchedType ==  Token {
            let matchers: [Cuckoo.ParameterMatcher<( Token)>] = [wrap(matchable: p0) { $0 }]
            return .init(stub: cuckoo_manager.createStub(for: MockConsumer.self,
                method: "inspect(_ p0: borrowing Token) -> Int",
                parameterMatchers: matchers
            ))
        }
    }

    struct __VerificationProxy_Consumer: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func consume<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<( Token), Void> where M1.MatchedType ==  Token {
            let matchers: [Cuckoo.ParameterMatcher<( Token)>] = [wrap(matchable: p0) { $0 }]
            return cuckoo_manager.verify(
                "consume(_ p0: consuming Token)",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func inspect<M1: Cuckoo.Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<( Token), Int> where M1.MatchedType ==  Token {
            let matchers: [Cuckoo.ParameterMatcher<( Token)>] = [wrap(matchable: p0) { $0 }]
            return cuckoo_manager.verify(
                "inspect(_ p0: borrowing Token) -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

class ConsumerStub:Consumer, @unchecked Sendable {


    
    func consume(_ p0: consuming Token) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
    
    func inspect(_ p0: borrowing Token) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
}



