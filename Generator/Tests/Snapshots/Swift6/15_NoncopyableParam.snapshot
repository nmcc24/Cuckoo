        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckooManager = manager
            self.cuckooCallMatcher = callMatcher
            self.cuckooSourceLocation = sourceLocation
