    func visit(_ p0: (borrowing Token) -> Void) {
        
		return withoutActuallyEscaping(p0, do: { (p0: @escaping (borrowing Token) -> Void) in
return cuckoo_manager.call(
            "visit(_ p0: (borrowing Token) -> Void)",
            parameters: (p0),
            escapingParameters: (({ _ in fatalError("This is a stub! It's not supposed to be called!") } as (borrowing Token) -> Void)),
