            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.NoncopyableArgument, Int)>] = [Cuckoo.wrap(matchable: p0) {
                    $0.0
                }, Cuckoo.wrap(matchable: p1) {
                    $0.1
                }]
            return .init(stub: cuckooManager.createStub(for: MockConsumer.self,
                method: "redeem(_ p0: consuming Ticket?, seat p1: Int) async throws -> String",
                parameterMatchers: matchers
            ))
        }

        func take<__M1: Cuckoo._Matchable>(_ p0: __M1) -> Cuckoo.ProtocolStubFunction<(Cuckoo.NoncopyableArgument), Bool, ((Cuckoo.NoncopyableArgument)) -> Bool, Cuckoo.StubSharing.Confined> where __M1.MatchedType == Cuckoo.NoncopyableArgument {
            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.NoncopyableArgument)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckooManager.createStub(for: MockConsumer.self,
