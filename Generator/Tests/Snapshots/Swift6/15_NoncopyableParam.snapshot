nonisolated final class ConsumerStub: Consumer {
    func consume(_ p0: consuming Token) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }

    func inspect(_ p0: borrowing Token) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }

    func redeem(_ p0: consuming Ticket?, seat p1: Int) async throws -> String {
        return DefaultValueRegistry.defaultValue(for: (String).self)
    }

    func take<T: ~Copyable> (_ p0: consuming T) -> Bool {
        return DefaultValueRegistry.defaultValue(for: (Bool).self)
    }

    func check<T> (_ p0: borrowing T, label p1: String) -> Bool where T: ~Copyable {
        return DefaultValueRegistry.defaultValue(for: (Bool).self)
    }

    func visit(_ p0: (borrowing Token) -> Void) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}

actor MockTokenVault: TokenVault, Cuckoo.ProtocolMock {
    typealias CuckooMocksType = any TokenVault
    typealias CuckooStubbing = __StubbingProxy_TokenVault
    typealias CuckooVerification = __VerificationProxy_TokenVault

    // Original typealiases

    nonisolated let cuckooManager = Cuckoo.MockManager.preconfiguredManager(for: MockTokenVault.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated func enableDefaultImplementation(_ stub: CuckooMocksType) {
        cuckooManager.refuseActorDefaultImplementation()
    }

    func deposit(_ p0: consuming Token, note p1: String) {
        return cuckooManager.call(
            "deposit(_ p0: consuming Token, note p1: String)",
            parameters: (Cuckoo.NoncopyableArgument(type: "Token"), p1),
            escapingParameters: (Cuckoo.NoncopyableArgument(type: "Token"), p1),
            invoke: { (implementation: @Sendable (isolated MockTokenVault, borrowing Token, String) -> Void, arguments) in
                implementation(self, p0, arguments.1)
