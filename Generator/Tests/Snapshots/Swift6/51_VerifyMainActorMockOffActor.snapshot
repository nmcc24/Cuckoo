import Cuckoo
import Foundation

final class MockPageRenderer: PageRenderer, nonisolated Cuckoo.ProtocolMock {
    typealias CuckooMocksType = any PageRenderer
    typealias CuckooStubbing = __StubbingProxy_PageRenderer
    typealias CuckooVerification = __VerificationProxy_PageRenderer

    // Original typealiases

    nonisolated let cuckooManager = Cuckoo.MockManager.preconfiguredManager(for: MockPageRenderer.self) ?? Cuckoo.MockManager(hasParent: false)
    nonisolated static var cuckooGlobalActor: (any Actor)? {
        MainActor.shared
    }

    nonisolated private let cuckooDefaultImplementation = Cuckoo.DefaultImplementation<any PageRenderer>()

    nonisolated func enableDefaultImplementation(_ stub: any PageRenderer) {
        cuckooDefaultImplementation.value = stub
        cuckooManager.enableDefaultStubImplementation()
    }

    func render(_ p0: Page) {
        return cuckooManager.call(
            "render(_ p0: Page)",
            parameters: (p0),
            escapingParameters: (p0),
            invoke: { (implementation: @MainActor @Sendable ((Page)) -> Void, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: cuckooDefaultImplementation.value.render(p0)
        )
    }

    nonisolated struct __StubbingProxy_PageRenderer: Cuckoo.StubbingProxy {
        private let cuckooManager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckooManager = manager
        }

        func render<__M1: Cuckoo._Matchable>(_ p0: __M1) -> Cuckoo.ProtocolStubNoReturnFunction<(Page), @MainActor @Sendable ((Page)) -> Void, Cuckoo.StubSharing.Isolated> where __M1.MatchedType == Page {
            let matchers: [Cuckoo.ParameterMatcher<(Page)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckooManager.createStub(for: MockPageRenderer.self,
                method: "render(_ p0: Page)",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_PageRenderer: Cuckoo.VerificationProxy {
        private let cuckooManager: Cuckoo.MockManager
        private let cuckooCallMatcher: Cuckoo.CallMatcher
        private let cuckooSourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckooManager = manager
            self.cuckooCallMatcher = callMatcher
            self.cuckooSourceLocation = sourceLocation
        }

        @MainActor
        @discardableResult
        func render<__M1: Cuckoo._Matchable>(_ p0: __M1) -> Cuckoo.VerifiedCall<(Page), Void> where __M1.MatchedType == Page {
            let matchers: [Cuckoo.ParameterMatcher<(Page)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckooManager.verify(
                "render(_ p0: Page)",
                callMatcher: cuckooCallMatcher,
                parameterMatchers: matchers,
                sourceLocation: cuckooSourceLocation
            )
        }
    }
}

final class PageRendererStub: PageRenderer {
    func render(_ p0: Page) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}
