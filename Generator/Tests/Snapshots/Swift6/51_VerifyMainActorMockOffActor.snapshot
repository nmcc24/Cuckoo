import Cuckoo
import Foundation

final class MockPageRenderer: PageRenderer, nonisolated Cuckoo.ProtocolMock {
    typealias MocksType = any PageRenderer
    typealias Stubbing = __StubbingProxy_PageRenderer
    typealias Verification = __VerificationProxy_PageRenderer

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager(for: MockPageRenderer.self) ?? Cuckoo.MockManager(hasParent: false)
    nonisolated static var cuckoo_globalActor: (any Actor)? {
        MainActor.shared
    }

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any PageRenderer>()

    nonisolated func enableDefaultImplementation(_ stub: any PageRenderer) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    func render(_ p0: Page) {
        return cuckoo_manager.call(
            "render(_ p0: Page)",
            parameters: (p0),
            escapingParameters: (p0),
            invoke: { (implementation: @MainActor @Sendable ((Page)) -> Void, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.render(p0)
        )
    }

    nonisolated struct __StubbingProxy_PageRenderer: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }

        func render<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubNoReturnFunction<(Page), @MainActor @Sendable ((Page)) -> Void, Cuckoo.StubSharing.Isolated> where M1.MatchedType == Page {
            let matchers: [Cuckoo.ParameterMatcher<(Page)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockPageRenderer.self,
                method: "render(_ p0: Page)",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_PageRenderer: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let cuckoo_callMatcher: Cuckoo.CallMatcher
        private let cuckoo_sourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.cuckoo_callMatcher = callMatcher
            self.cuckoo_sourceLocation = sourceLocation
        }

        @MainActor
        @discardableResult
        func render<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<(Page), Void> where M1.MatchedType == Page {
            let matchers: [Cuckoo.ParameterMatcher<(Page)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckoo_manager.verify(
                "render(_ p0: Page)",
                callMatcher: cuckoo_callMatcher,
                parameterMatchers: matchers,
                sourceLocation: cuckoo_sourceLocation
            )
        }
    }
}

final class PageRendererStub: PageRenderer {
    func render(_ p0: Page) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}
