import Cuckoo
import Foundation

final class MockCoordinator: Coordinator, nonisolated Cuckoo.ProtocolMock {
    typealias MocksType = any Coordinator
    typealias Stubbing = __StubbingProxy_Coordinator
    typealias Verification = __VerificationProxy_Coordinator

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any Coordinator>()

    nonisolated func enableDefaultImplementation(_ stub: any Coordinator) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    nonisolated
    func identifier() -> String {
        return cuckoo_manager.call(
            "identifier() -> String",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: (()) -> String, arguments) in implementation(arguments) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.identifier()
        )
    }

    func start() {
        return cuckoo_manager.call(
            "start()",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: @MainActor @Sendable (()) -> Void, arguments) in implementation(arguments) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.start()
        )
    }

    nonisolated struct __StubbingProxy_Coordinator: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func identifier() -> Cuckoo.ProtocolStubFunction<(), String, (()) -> String, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockCoordinator.self,
                method: "identifier() -> String",
                parameterMatchers: matchers
            ))
        }
        
        func start() -> Cuckoo.ProtocolStubNoReturnFunction<(), @MainActor @Sendable (()) -> Void, Cuckoo.StubSharing.Isolated> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockCoordinator.self,
                method: "start()",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_Coordinator: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func identifier() -> Cuckoo.__DoNotUse<(), String> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "identifier() -> String",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func start() -> Cuckoo.__DoNotUse<(), Void> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "start()",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

final class CoordinatorStub:Coordinator {


    
    nonisolated
    func identifier() -> String {
        return DefaultValueRegistry.defaultValue(for: (String).self)
    }
    
    func start() {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}



