import Cuckoo
import Foundation

final class MockGreeter: Greeter, Cuckoo.ProtocolMock {
    typealias MocksType = any Greeter
    typealias Stubbing = __StubbingProxy_Greeter
    typealias Verification = __VerificationProxy_Greeter

    // Original typealiases

    let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    private let __defaultImplStub = Cuckoo.DefaultImplementation<any Greeter>()

    nonisolated func enableDefaultImplementation(_ stub: any Greeter) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    var count: Int {
        get {
            return cuckoo_manager.getter(
                "count",
                invoke: { (implementation: (()) -> Int) in implementation(()) },
                superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
                defaultCall: __defaultImplStub.value.count
            )
        }
        set {
            cuckoo_manager.setter(
                "count",
                value: newValue,
                invoke: { (implementation: (Int) -> Void) in implementation(newValue) },
                superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
                defaultCall: __defaultImplStub.value.count = newValue
            )
        }
    }


    func greet(name p0: String) -> String {
        return cuckoo_manager.call(
            "greet(name p0: String) -> String",
            parameters: (p0),
            escapingParameters: (p0),
            invoke: { (implementation: ((String)) -> String) in implementation((p0)) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.greet(name: p0)
        )
    }

    struct __StubbingProxy_Greeter: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        var count: Cuckoo.ProtocolToBeStubbedProperty<MockGreeter, Int, (()) -> Int, (Int) -> Void, Cuckoo.StubSharing.Confined> {
            return .init(manager: cuckoo_manager, name: "count")
        }
        
        func greet<M1: Cuckoo.Matchable>(name p0: M1) -> Cuckoo.ProtocolStubFunction<(String), String, ((String)) -> String, Cuckoo.StubSharing.Confined> where M1.MatchedType == String {
            let matchers: [Cuckoo.ParameterMatcher<(String)>] = [wrap(matchable: p0) { $0 }]
            return .init(stub: cuckoo_manager.createStub(for: MockGreeter.self,
                method: "greet(name p0: String) -> String",
                parameterMatchers: matchers
            ))
        }
    }

    struct __VerificationProxy_Greeter: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        var count: Cuckoo.VerifyProperty<Int> {
            return .init(manager: cuckoo_manager, name: "count", callMatcher: callMatcher, sourceLocation: sourceLocation)
        }
        
        
        @discardableResult
        func greet<M1: Cuckoo.Matchable>(name p0: M1) -> Cuckoo.__DoNotUse<(String), String> where M1.MatchedType == String {
            let matchers: [Cuckoo.ParameterMatcher<(String)>] = [wrap(matchable: p0) { $0 }]
            return cuckoo_manager.verify(
                "greet(name p0: String) -> String",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

final class GreeterStub:Greeter {
    
    var count: Int {
        get {
            return DefaultValueRegistry.defaultValue(for: (Int).self)
        }
        set {}
    }


    
    func greet(name p0: String) -> String {
        return DefaultValueRegistry.defaultValue(for: (String).self)
    }
}



