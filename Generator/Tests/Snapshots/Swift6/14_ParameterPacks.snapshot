        @discardableResult
        func log<M1: Cuckoo._Matchable, M2: Cuckoo._Matchable>(prefix p0: M1, _ p1: M2) -> Cuckoo.__DoNotUse<(String, Cuckoo.ParameterPack), Void> where M1.MatchedType == String, M2.MatchedType == Cuckoo.ParameterPack {
            let matchers: [Cuckoo.ParameterMatcher<(String, Cuckoo.ParameterPack)>] = [Cuckoo.wrap(matchable: p0) {
