    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager(for: MockCombiner.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any Combiner>()

    nonisolated func enableDefaultImplementation(_ stub: any Combiner) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    func combine<each T> (_ p0: repeat each T) -> (repeat each T) {
        return cuckoo_manager.call(
            "combine<each T> (_ p0: repeat each T) -> (repeat each T)",
            parameters: (Cuckoo.ParameterPack(repeat each p0)),
            escapingParameters: (Cuckoo.ParameterPack(repeat each p0)),
            invoke: { (implementation: ((Cuckoo.ParameterPack)) -> (repeat each T), arguments) in
