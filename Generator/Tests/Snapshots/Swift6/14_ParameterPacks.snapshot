        @discardableResult
        func count<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<(Cuckoo.ParameterPack), Int> where M1.MatchedType == Cuckoo.ParameterPack {
            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.ParameterPack)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckoo_manager.verify(
                "count<each T> (_ p0: repeat each T) -> Int",
                callMatcher: cuckoo_callMatcher,
                parameterMatchers: matchers,
                sourceLocation: cuckoo_sourceLocation
            )
