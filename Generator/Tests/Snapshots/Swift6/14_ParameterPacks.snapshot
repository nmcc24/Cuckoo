            parameters: (p0, Cuckoo.ParameterPack(repeat each p1)),
            escapingParameters: (p0, Cuckoo.ParameterPack(repeat each p1)),
            errorType: (any Swift.Error).self,
            invoke: { (implementation: nonisolated(nonsending) ((String, Cuckoo.ParameterPack)) async throws -> Void, arguments) async throws(any Swift.Error) in
                try await implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.log(prefix: p0, repeat each p1)
        )
    }

    func pair<each T, each U> (_ p0: repeat each T, second p1: repeat each U) -> (repeat each U) {
        return cuckoo_manager.call(
            "pair<each T, each U> (_ p0: repeat each T, second p1: repeat each U) -> (repeat each U)",
            parameters: (Cuckoo.ParameterPack(repeat each p0), Cuckoo.ParameterPack(repeat each p1)),
