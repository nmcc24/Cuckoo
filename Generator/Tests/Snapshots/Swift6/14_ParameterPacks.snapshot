nonisolated final class CombinerStub: Combiner {
    func combine<each T> (_ p0: repeat each T) -> (repeat each T) {
        return DefaultValueRegistry.defaultValue(for: ((repeat each T)).self)
    }

    func count<each T> (_ p0: repeat each T) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }

    func log<each T: Sendable> (prefix p0: String, _ p1: repeat each T) async throws {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }

    func pair<each T, each U> (_ p0: repeat each T, second p1: repeat each U) -> (repeat each U) {
        return DefaultValueRegistry.defaultValue(for: ((repeat each U)).self)
    }
}

