        private let cuckoo_manager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }

        func combine<M1: Cuckoo._Matchable, each T>(_ p0: M1) -> Cuckoo.ProtocolStubFunction<(Cuckoo.ParameterPack), (repeat each T), ((Cuckoo.ParameterPack)) -> (repeat each T), Cuckoo.StubSharing.Confined> where M1.MatchedType == Cuckoo.ParameterPack {
            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.ParameterPack)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
