        func log<M1: Cuckoo._Matchable, M2: Cuckoo._Matchable>(prefix p0: M1, _ p1: M2) -> Cuckoo.ProtocolStubNoReturnThrowingFunction<(String, Cuckoo.ParameterPack), any Swift.Error, nonisolated(nonsending) ((String, Cuckoo.ParameterPack)) async throws -> Void, Cuckoo.StubSharing.Confined> where M1.MatchedType == String, M2.MatchedType == Cuckoo.ParameterPack {
            let matchers: [Cuckoo.ParameterMatcher<(String, Cuckoo.ParameterPack)>] = [Cuckoo.wrap(matchable: p0) {
                    $0.0
                }, Cuckoo.wrap(matchable: p1) {
                    $0.1
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockCombiner.self,
                method: "log<each T: Sendable> (prefix p0: String, _ p1: repeat each T) async throws",
                parameterMatchers: matchers
            ))
        }

        func pair<M1: Cuckoo._Matchable, M2: Cuckoo._Matchable, each U>(_ p0: M1, second p1: M2) -> Cuckoo.ProtocolStubFunction<(Cuckoo.ParameterPack, Cuckoo.ParameterPack), (repeat each U), ((Cuckoo.ParameterPack, Cuckoo.ParameterPack)) -> (repeat each U), Cuckoo.StubSharing.Confined> where M1.MatchedType == Cuckoo.ParameterPack, M2.MatchedType == Cuckoo.ParameterPack {
            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.ParameterPack, Cuckoo.ParameterPack)>] = [Cuckoo.wrap(matchable: p0) {
