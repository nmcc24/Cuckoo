        func count<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubFunction<(Cuckoo.ParameterPack), Int, ((Cuckoo.ParameterPack)) -> Int, Cuckoo.StubSharing.Confined> where M1.MatchedType == Cuckoo.ParameterPack {
            let matchers: [Cuckoo.ParameterMatcher<(Cuckoo.ParameterPack)>] = [Cuckoo.wrap(matchable: p0) {
