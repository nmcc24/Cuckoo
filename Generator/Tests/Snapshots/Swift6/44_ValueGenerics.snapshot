@available(macOS 26, iOS 26, tvOS 26, watchOS 26, *)
final class FixedBufferStub<let Count: Int>: FixedBuffer<Count> {
    override func first<let N: Int> (_ p0: InlineArray<N, Int>) -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
