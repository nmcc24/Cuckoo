import Cuckoo
import Foundation

final class MockFactory: Factory, Cuckoo.ProtocolMock {
    typealias MocksType = any Factory
    typealias Stubbing = __StubbingProxy_Factory
    typealias Verification = __VerificationProxy_Factory

    // Original typealiases

    let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    private let __defaultImplStub = Cuckoo.DefaultImplementation<any Factory>()

    nonisolated func enableDefaultImplementation(_ stub: any Factory) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    func build() -> Int {
        return cuckoo_manager.call(
            "build() -> Int",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: (()) -> Int) in implementation(()) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.build()
        )
    }

    struct __StubbingProxy_Factory: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func build() -> Cuckoo.ProtocolStubFunction<(), Int, (()) -> Int, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockFactory.self,
                method: "build() -> Int",
                parameterMatchers: matchers
            ))
        }
    }

    struct __VerificationProxy_Factory: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func build() -> Cuckoo.__DoNotUse<(), Int> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "build() -> Int",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

final class FactoryStub:Factory {


    
    func build() -> Int {
        return DefaultValueRegistry.defaultValue(for: (Int).self)
    }
}



