import Cuckoo
import Foundation

@available(macOS 15, iOS 18, tvOS 18, watchOS 11, *)
nonisolated final class MockEvents: Events, nonisolated Cuckoo.ProtocolMock {
    typealias CuckooMocksType = any Events
    typealias CuckooStubbing = __StubbingProxy_Events
    typealias CuckooVerification = __VerificationProxy_Events

    // Original typealiases

    nonisolated let cuckooManager = Cuckoo.MockManager.preconfiguredManager(for: MockEvents.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let cuckooDefaultImplementation = Cuckoo.DefaultImplementation<any Events>()

    nonisolated func enableDefaultImplementation(_ stub: any Events) {
        cuckooDefaultImplementation.value = stub
        cuckooManager.enableDefaultStubImplementation()
    }

    var stream: AsyncStream<Int> {
        get {
            return cuckooManager.getter(
                "stream",
                invoke: { (implementation: (()) -> AsyncStream<Int>) in
                    implementation(())
                },
                superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
                defaultCall: cuckooDefaultImplementation.value.stream
            )
        }
    }

    func updates() -> any AsyncSequence<Int, Never> {
        return cuckooManager.call(
            "updates() -> any AsyncSequence<Int, Never>",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: (()) -> any AsyncSequence<Int, Never>, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: cuckooDefaultImplementation.value.updates()
        )
    }

    nonisolated struct __StubbingProxy_Events: Cuckoo.StubbingProxy {
        private let cuckooManager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckooManager = manager
        }

        var stream: Cuckoo.ProtocolToBeStubbedReadOnlyProperty<MockEvents, AsyncStream<Int>, (()) -> AsyncStream<Int>, Cuckoo.StubSharing.Confined> {
            return .init(manager: cuckooManager, name: "stream")
        }

        func updates() -> Cuckoo.ProtocolStubFunction<(), any AsyncSequence<Int, Never>, (()) -> any AsyncSequence<Int, Never>, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckooManager.createStub(for: MockEvents.self,
                method: "updates() -> any AsyncSequence<Int, Never>",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_Events: Cuckoo.VerificationProxy {
        private let cuckooManager: Cuckoo.MockManager
        private let cuckooCallMatcher: Cuckoo.CallMatcher
        private let cuckooSourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckooManager = manager
            self.cuckooCallMatcher = callMatcher
            self.cuckooSourceLocation = sourceLocation
        }

        var stream: Cuckoo.VerifyReadOnlyProperty<AsyncStream<Int>> {
            return .init(manager: cuckooManager, name: "stream", callMatcher: cuckooCallMatcher, sourceLocation: cuckooSourceLocation)
        }

        @discardableResult
        func updates() -> Cuckoo.__DoNotUse<(), any AsyncSequence<Int, Never>> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckooManager.verify(
                "updates() -> any AsyncSequence<Int, Never>",
                callMatcher: cuckooCallMatcher,
                parameterMatchers: matchers,
                sourceLocation: cuckooSourceLocation
            )
        }
    }
}

@available(macOS 15, iOS 18, tvOS 18, watchOS 11, *)
nonisolated final class EventsStub: Events {
    var stream: AsyncStream<Int> {
        get {
            return DefaultValueRegistry.defaultValue(for: (AsyncStream<Int>).self)
        }
    }

    func updates() -> any AsyncSequence<Int, Never> {
        return DefaultValueRegistry.defaultValue(for: (any AsyncSequence<Int, Never>).self)
    }
}
