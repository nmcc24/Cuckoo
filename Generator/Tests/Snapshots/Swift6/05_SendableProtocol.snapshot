import Cuckoo
import Foundation

class MockNetworking: Networking, Cuckoo.ProtocolMock, @unchecked Sendable {
    typealias MocksType = any Networking
    typealias Stubbing = __StubbingProxy_Networking
    typealias Verification = __VerificationProxy_Networking

    // Original typealiases

    let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    private let __defaultImplStub = Cuckoo.DefaultImplementation<any Networking>()

    nonisolated func enableDefaultImplementation(_ stub: any Networking) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    func get(url p0: String, completion p1: @escaping @Sendable (Result<String, Error>) -> Void) {
        return cuckoo_manager.call(
            "get(url p0: String, completion p1: @escaping @Sendable (Result<String, Error>) -> Void)",
            parameters: (p0, p1),
            escapingParameters: (p0, p1),
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.get(url: p0, completion: p1)
        )
    }

    func get(url p0: String) async throws -> String {
        return try await cuckoo_manager.callThrows(
            "get(url p0: String) async throws -> String",
            parameters: (p0),
            escapingParameters: (p0),
            errorType: Swift.Error.self,
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: await __defaultImplStub.value.get(url: p0)
        )
    }

    struct __StubbingProxy_Networking: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func get<M1: Cuckoo.Matchable, M2: Cuckoo.Matchable>(url p0: M1, completion p1: M2) -> Cuckoo.ProtocolStubNoReturnFunction<(String, @Sendable (Result<String, Error>) -> Void)> where M1.MatchedType == String, M2.MatchedType == @Sendable (Result<String, Error>) -> Void {
            let matchers: [Cuckoo.ParameterMatcher<(String, @Sendable (Result<String, Error>) -> Void)>] = [wrap(matchable: p0) { $0.0 }, wrap(matchable: p1) { $0.1 }]
            return .init(stub: cuckoo_manager.createStub(for: MockNetworking.self,
                method: "get(url p0: String, completion p1: @escaping @Sendable (Result<String, Error>) -> Void)",
                parameterMatchers: matchers
            ))
        }
        
        func get<M1: Cuckoo.Matchable>(url p0: M1) -> Cuckoo.ProtocolStubThrowingFunction<(String), String,Swift.Error> where M1.MatchedType == String {
            let matchers: [Cuckoo.ParameterMatcher<(String)>] = [wrap(matchable: p0) { $0 }]
            return .init(stub: cuckoo_manager.createStub(for: MockNetworking.self,
                method: "get(url p0: String) async throws -> String",
                parameterMatchers: matchers
            ))
        }
    }

    struct __VerificationProxy_Networking: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func get<M1: Cuckoo.Matchable, M2: Cuckoo.Matchable>(url p0: M1, completion p1: M2) -> Cuckoo.__DoNotUse<(String, @Sendable (Result<String, Error>) -> Void), Void> where M1.MatchedType == String, M2.MatchedType == @Sendable (Result<String, Error>) -> Void {
            let matchers: [Cuckoo.ParameterMatcher<(String, @Sendable (Result<String, Error>) -> Void)>] = [wrap(matchable: p0) { $0.0 }, wrap(matchable: p1) { $0.1 }]
            return cuckoo_manager.verify(
                "get(url p0: String, completion p1: @escaping @Sendable (Result<String, Error>) -> Void)",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func get<M1: Cuckoo.Matchable>(url p0: M1) -> Cuckoo.__DoNotUse<(String), String> where M1.MatchedType == String {
            let matchers: [Cuckoo.ParameterMatcher<(String)>] = [wrap(matchable: p0) { $0 }]
            return cuckoo_manager.verify(
                "get(url p0: String) async throws -> String",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

class NetworkingStub:Networking, @unchecked Sendable {


    
    func get(url p0: String, completion p1: @escaping @Sendable (Result<String, Error>) -> Void) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
    
    func get(url p0: String) async throws -> String {
        return DefaultValueRegistry.defaultValue(for: (String).self)
    }
}



