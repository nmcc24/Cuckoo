    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager(for: MockClosureSpecifierService.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any ClosureSpecifierService>()

    nonisolated func enableDefaultImplementation(_ stub: any ClosureSpecifierService) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    func run(_ p0: sending () -> Void) {
        let __p0 = Cuckoo.__SendingArgument(p0)
        return withoutActuallyEscaping(p0, do: { (p0: @escaping () -> Void) in
            return cuckoo_manager.call(
                "run(_ p0: sending () -> Void)",
                parameters: (p0),
                escapingParameters: (({ () in
