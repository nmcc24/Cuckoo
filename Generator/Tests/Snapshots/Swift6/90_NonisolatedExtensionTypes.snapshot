            func leaf() -> Cuckoo.VerifiedCall<(), Void> {
                let matchers: [Cuckoo.ParameterMatcher<Void>] = []
                return cuckooManager.verify(
                    "leaf()",
                    callMatcher: cuckooCallMatcher,
                    parameterMatchers: matchers,
                    sourceLocation: cuckooSourceLocation
                )
            }
        }
    }

    nonisolated final class LeafingStub: Leafing {
        func leaf() {
            typealias __CuckooDefault = Void
            return DefaultValueRegistry.defaultValue(for: __CuckooDefault.self)
        }
    }
}
