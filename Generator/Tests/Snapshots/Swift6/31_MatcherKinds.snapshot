import Cuckoo
import Foundation

nonisolated final class MockProfileStore: ProfileStore, nonisolated Cuckoo.ProtocolMock {
    typealias MocksType = any ProfileStore
    typealias Stubbing = __StubbingProxy_ProfileStore
    typealias Verification = __VerificationProxy_ProfileStore

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager(for: MockProfileStore.self) ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any ProfileStore>()

    nonisolated func enableDefaultImplementation(_ stub: any ProfileStore) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    func save(_ p0: Profile, tags p1: [String]) -> Bool {
        return cuckoo_manager.call(
            "save(_ p0: Profile, tags p1: [String]) -> Bool",
            parameters: (p0, p1),
            escapingParameters: (p0, p1),
            invoke: { (implementation: ((Profile, [String])) -> Bool, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.save(p0, tags: p1)
        )
    }

    func open(_ p0: Session) {
        return cuckoo_manager.call(
            "open(_ p0: Session)",
            parameters: (p0),
            escapingParameters: (p0),
            invoke: { (implementation: ((Session)) -> Void, arguments) in
                implementation(arguments)
            },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.open(p0)
        )
    }

    nonisolated struct __StubbingProxy_ProfileStore: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }

        func save<M1: Cuckoo._Matchable, M2: Cuckoo._Matchable>(_ p0: M1, tags p1: M2) -> Cuckoo.ProtocolStubFunction<(Profile, [String]), Bool, ((Profile, [String])) -> Bool, Cuckoo.StubSharing.Confined> where M1.MatchedType == Profile, M2.MatchedType == [String] {
            let matchers: [Cuckoo.ParameterMatcher<(Profile, [String])>] = [Cuckoo.wrap(matchable: p0) {
                    $0.0
                }, Cuckoo.wrap(matchable: p1) {
                    $0.1
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockProfileStore.self,
                method: "save(_ p0: Profile, tags p1: [String]) -> Bool",
                parameterMatchers: matchers
            ))
        }

        func open<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.ProtocolStubNoReturnFunction<(Session), ((Session)) -> Void, Cuckoo.StubSharing.Confined> where M1.MatchedType == Session {
            let matchers: [Cuckoo.ParameterMatcher<(Session)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockProfileStore.self,
                method: "open(_ p0: Session)",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_ProfileStore: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }

        @discardableResult
        func save<M1: Cuckoo._Matchable, M2: Cuckoo._Matchable>(_ p0: M1, tags p1: M2) -> Cuckoo.__DoNotUse<(Profile, [String]), Bool> where M1.MatchedType == Profile, M2.MatchedType == [String] {
            let matchers: [Cuckoo.ParameterMatcher<(Profile, [String])>] = [Cuckoo.wrap(matchable: p0) {
                    $0.0
                }, Cuckoo.wrap(matchable: p1) {
                    $0.1
                }]
            return cuckoo_manager.verify(
                "save(_ p0: Profile, tags p1: [String]) -> Bool",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }

        @discardableResult
        func open<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<(Session), Void> where M1.MatchedType == Session {
            let matchers: [Cuckoo.ParameterMatcher<(Session)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckoo_manager.verify(
                "open(_ p0: Session)",
