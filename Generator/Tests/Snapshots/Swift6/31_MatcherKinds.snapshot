nonisolated final class ProfileStoreStub: ProfileStore {
    func save(_ p0: Profile, tags p1: [String]) -> Bool {
        return DefaultValueRegistry.defaultValue(for: (Bool).self)
    }

    func open(_ p0: Session) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}

