import Cuckoo
import Foundation

nonisolated final class MockConfigurable: Configurable, nonisolated Cuckoo.ProtocolMock {
    typealias MocksType = any Configurable
    typealias Stubbing = __StubbingProxy_Configurable
    typealias Verification = __VerificationProxy_Configurable

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<any Configurable>()

    nonisolated func enableDefaultImplementation(_ stub: any Configurable) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    required init<T> (value p0: T) {}
    required init<C: Collection> (items p0: C) where C.Element == Int {}
    required init<T: Equatable> (maybe p0: T) {}

    func describe() -> String {
        return cuckoo_manager.call(
            "describe() -> String",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: (()) -> String, arguments) in implementation(arguments) },
            superclassCall: Cuckoo.MockManager.crashOnProtocolSuperclassCall(),
            defaultCall: __defaultImplStub.value.describe()
        )
    }

    nonisolated struct __StubbingProxy_Configurable: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        func describe() -> Cuckoo.ProtocolStubFunction<(), String, (()) -> String, Cuckoo.StubSharing.Confined> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockConfigurable.self,
                method: "describe() -> String",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_Configurable: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        
        @discardableResult
        func describe() -> Cuckoo.__DoNotUse<(), String> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "describe() -> String",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

nonisolated final class ConfigurableStub:Configurable {

    
    required init<T> (value p0: T) {}
    
    required init<C: Collection> (items p0: C) where C.Element == Int {}
    
    required init<T: Equatable> (maybe p0: T) {}

    
    func describe() -> String {
        return DefaultValueRegistry.defaultValue(for: (String).self)
    }
}


