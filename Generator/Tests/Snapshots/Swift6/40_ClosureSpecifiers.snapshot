import Cuckoo
import Foundation

final class MockClosureSpecifierRunner: ClosureSpecifierRunner, nonisolated Cuckoo.ClassMock {
    typealias MocksType = ClosureSpecifierRunner
    typealias Stubbing = __StubbingProxy_ClosureSpecifierRunner
    typealias Verification = __VerificationProxy_ClosureSpecifierRunner

    // Not mocked, so calls run the class's own implementation:
    // - 'run(_ operation: sending () -> Void)' takes 'sending () -> Void', a non-escaping closure with a specifier, which a mock can't record yet.
    // - 'swap(_ operation: inout () -> Void)' takes 'inout () -> Void', a non-escaping closure with a specifier, which a mock can't record yet.
    // - 'read(_ operation: borrowing () -> Int)' takes 'borrowing () -> Int', a non-escaping closure with a specifier, which a mock can't record yet.

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager(for: MockClosureSpecifierRunner.self) ?? Cuckoo.MockManager(hasParent: true)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<ClosureSpecifierRunner>()

    nonisolated func enableDefaultImplementation(_ stub: ClosureSpecifierRunner) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    override func plain(_ p0: () -> Void) {
        return withoutActuallyEscaping(p0, do: { (p0: @escaping () -> Void) in
            return cuckoo_manager.call(
                "plain(_ p0: () -> Void)",
                parameters: (p0),
                escapingParameters: (({ () in
                                        fatalError("This is a stub! It's not supposed to be called!")
                                    } as () -> Void)),
                invoke: { (implementation: ((@escaping () -> Void)) -> Void, arguments) in
                                implementation(arguments)
                            },
                superclassCall: super.plain(p0),
                defaultCall: __defaultImplStub.value.plain(p0)
            )
        })
    }

    nonisolated struct __StubbingProxy_ClosureSpecifierRunner: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager

        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }

        func plain<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.ClassStubNoReturnFunction<(() -> Void), ((@escaping () -> Void)) -> Void, Cuckoo.StubSharing.Confined> where M1.MatchedType == () -> Void {
            let matchers: [Cuckoo.ParameterMatcher<(() -> Void)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return .init(stub: cuckoo_manager.createStub(for: MockClosureSpecifierRunner.self,
                method: "plain(_ p0: () -> Void)",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_ClosureSpecifierRunner: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation

        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }

        @discardableResult
        func plain<M1: Cuckoo._Matchable>(_ p0: M1) -> Cuckoo.__DoNotUse<(() -> Void), Void> where M1.MatchedType == () -> Void {
            let matchers: [Cuckoo.ParameterMatcher<(() -> Void)>] = [Cuckoo.wrap(matchable: p0) {
                    $0
                }]
            return cuckoo_manager.verify(
                "plain(_ p0: () -> Void)",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

final class ClosureSpecifierRunnerStub: ClosureSpecifierRunner {
    override func plain(_ p0: () -> Void) {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
}

