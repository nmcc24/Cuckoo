import Cuckoo
import Foundation

final class MockViewModel: ViewModel, nonisolated Cuckoo.ClassMock {
    typealias MocksType = ViewModel
    typealias Stubbing = __StubbingProxy_ViewModel
    typealias Verification = __VerificationProxy_ViewModel

    // Original typealiases

    nonisolated let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: true)

    nonisolated private let __defaultImplStub = Cuckoo.DefaultImplementation<ViewModel>()

    nonisolated func enableDefaultImplementation(_ stub: ViewModel) {
        __defaultImplStub.value = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }

    override var state: String {
        get {
            return cuckoo_manager.getter(
                "state",
                invoke: { (implementation: @MainActor @Sendable (()) -> String) in implementation(()) },
                superclassCall: super.state,
                defaultCall: __defaultImplStub.value.state
            )
        }
        set {
            cuckoo_manager.setter(
                "state",
                value: newValue,
                invoke: { (implementation: @MainActor @Sendable (String) -> Void) in implementation(newValue) },
                superclassCall: super.state = newValue,
                defaultCall: __defaultImplStub.value.state = newValue
            )
        }
    }


    override func reload() async {
        return await cuckoo_manager.call(
            "reload() async",
            parameters: (),
            escapingParameters: (),
            invoke: { (implementation: @MainActor @Sendable (()) async -> Void) in await implementation(()) },
            superclassCall: await super.reload(),
            defaultCall: await __defaultImplStub.value.reload()
        )
    }

    override func select(index p0: Int) -> Bool {
        return cuckoo_manager.call(
            "select(index p0: Int) -> Bool",
            parameters: (p0),
            escapingParameters: (p0),
            invoke: { (implementation: @MainActor @Sendable ((Int)) -> Bool) in implementation((p0)) },
            superclassCall: super.select(index: p0),
            defaultCall: __defaultImplStub.value.select(index: p0)
        )
    }

    nonisolated struct __StubbingProxy_ViewModel: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
        
        var state: Cuckoo.ClassToBeStubbedProperty<MockViewModel, String, @MainActor @Sendable (()) -> String, @MainActor @Sendable (String) -> Void, Cuckoo.StubSharing.Isolated> {
            return .init(manager: cuckoo_manager, name: "state")
        }
        
        func reload() -> Cuckoo.ClassStubNoReturnFunction<(), @MainActor @Sendable (()) async -> Void, Cuckoo.StubSharing.Isolated> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return .init(stub: cuckoo_manager.createStub(for: MockViewModel.self,
                method: "reload() async",
                parameterMatchers: matchers
            ))
        }
        
        func select<M1: Cuckoo.Matchable>(index p0: M1) -> Cuckoo.ClassStubFunction<(Int), Bool, @MainActor @Sendable ((Int)) -> Bool, Cuckoo.StubSharing.Isolated> where M1.MatchedType == Int {
            let matchers: [Cuckoo.ParameterMatcher<(Int)>] = [wrap(matchable: p0) { $0 }]
            return .init(stub: cuckoo_manager.createStub(for: MockViewModel.self,
                method: "select(index p0: Int) -> Bool",
                parameterMatchers: matchers
            ))
        }
    }

    nonisolated struct __VerificationProxy_ViewModel: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
        
        var state: Cuckoo.VerifyProperty<String> {
            return .init(manager: cuckoo_manager, name: "state", callMatcher: callMatcher, sourceLocation: sourceLocation)
        }
        
        
        @discardableResult
        func reload() -> Cuckoo.__DoNotUse<(), Void> {
            let matchers: [Cuckoo.ParameterMatcher<Void>] = []
            return cuckoo_manager.verify(
                "reload() async",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
        
        
        @discardableResult
        func select<M1: Cuckoo.Matchable>(index p0: M1) -> Cuckoo.__DoNotUse<(Int), Bool> where M1.MatchedType == Int {
            let matchers: [Cuckoo.ParameterMatcher<(Int)>] = [wrap(matchable: p0) { $0 }]
            return cuckoo_manager.verify(
                "select(index p0: Int) -> Bool",
                callMatcher: callMatcher,
                parameterMatchers: matchers,
                sourceLocation: sourceLocation
            )
        }
    }
}

final class ViewModelStub:ViewModel {
    
    override var state: String {
        get {
            return DefaultValueRegistry.defaultValue(for: (String).self)
        }
        set {}
    }


    
    override func reload() async {
        return DefaultValueRegistry.defaultValue(for: (Void).self)
    }
    
    override func select(index p0: Int) -> Bool {
        return DefaultValueRegistry.defaultValue(for: (Bool).self)
    }
}



