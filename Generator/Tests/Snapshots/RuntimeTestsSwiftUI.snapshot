import Cuckoo
import SwiftUI
import Foundation
@testable import Cuckoo
@testable import CuckooTestSources

class MockSwiftUIViewModelProtocol: SwiftUIViewModelProtocol, Cuckoo.ProtocolMock, @unchecked Sendable {
    typealias MocksType = any SwiftUIViewModelProtocol
    typealias Stubbing = __StubbingProxy_SwiftUIViewModelProtocol
    typealias Verification = __VerificationProxy_SwiftUIViewModelProtocol

    // Original typealiases

    let cuckoo_manager = Cuckoo.MockManager.preconfiguredManager ?? Cuckoo.MockManager(hasParent: false)

    private var __defaultImplStub: (any SwiftUIViewModelProtocol)?

    func enableDefaultImplementation(_ stub: any SwiftUIViewModelProtocol) {
        __defaultImplStub = stub
        cuckoo_manager.enableDefaultStubImplementation()
    }


    struct __StubbingProxy_SwiftUIViewModelProtocol: Cuckoo.StubbingProxy {
        private let cuckoo_manager: Cuckoo.MockManager
    
        init(manager: Cuckoo.MockManager) {
            self.cuckoo_manager = manager
        }
    }

    struct __VerificationProxy_SwiftUIViewModelProtocol: Cuckoo.VerificationProxy {
        private let cuckoo_manager: Cuckoo.MockManager
        private let callMatcher: Cuckoo.CallMatcher
        private let sourceLocation: Cuckoo.SourceLocation
    
        init(manager: Cuckoo.MockManager, callMatcher: Cuckoo.CallMatcher, sourceLocation: Cuckoo.SourceLocation) {
            self.cuckoo_manager = manager
            self.callMatcher = callMatcher
            self.sourceLocation = sourceLocation
        }
    }
}

class SwiftUIViewModelProtocolStub:SwiftUIViewModelProtocol, @unchecked Sendable {


}


